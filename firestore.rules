rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 各端末は自分(匿名ログインのID)のドキュメントだけ読み書きできる
    match /devices/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
